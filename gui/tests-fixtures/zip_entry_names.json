    },
    {
      "name": "firmware//Z_9/5.31/firmware.bin",
      "accept": false,
      "why": "empty component"
    },
    {
      "name": "firmware/Z_9/5.31//firmware.bin",
      "accept": false,
      "why": "empty component"
    },
    {
      "name": "snapshots/",
      "accept": false,
      "why": "trailing slash: a directory entry"
    },
    {
      "name": "snapshots/foo.json/",
      "accept": false,
      "why": "trailing slash"
    },
    {
      "name": "snapshots/a\\b.json",
      "accept": false,
      "why": "backslash inside a component"
    },
    {
      "name": "snapshots\\foo.json",
      "accept": false,
      "why": "backslash as a separator"
    },
    {
      "name": "snapshots/a\u0000b.json",
      "accept": false,
      "why": "NUL"
    },
    {
      "name": "firmware/../5.31/firmware.bin",
      "accept": false,
      "why": ".. as the slug in an otherwise valid 4-part name"
    },
    {
      "name": "firmware/Z_9/../firmware.bin",
      "accept": false,
      "why": ".. as the version in an otherwise valid 4-part name"
    },
    {
      "name": "firmware/./5.31/firmware.bin",
      "accept": false,
      "why": ". as the slug in an otherwise valid 4-part name"
    },
    {
      "name": "firmware/Z_9/./metadata.json",
      "accept": false,
      "why": ". as the version in an otherwise valid 4-part name"
    },
    {
      "name": "firmware//5.31/firmware.bin",
      "accept": false,
      "why": "empty slug in an otherwise valid 4-part name"
    }
  ]
}
